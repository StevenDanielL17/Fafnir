# ═══════════════════════════════════════════
# FAFNIR — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Hedera ──────────────────────────────────
# Get a free testnet account at https://portal.hedera.com
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.8113798
HEDERA_OPERATOR_KEY=3030020100300706052b8104000a042204200fca92733b20d11583e4814086516f933aa03271da7d69d3437b6b01834f9ea8

# ── OpenAI / LLM (Week 2) ──────────────────
# Required for LLM-powered goal parsing, rule evaluation, and chat.
# Get an API key at https://platform.openai.com/api-keys
# Without this key, Fafnir falls back to keyword-based parsing.
OPENAI_API_KEY=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

# ── Database (Week 3) ──────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/fafnir

# ── HOL Registry (Week 3) ──────────────────
# HOL_REGISTRY_TOPIC_ID=0.0.XXXXXX

# ── Auth ────────────────────────────────────
JWT_SECRET=ad3c8b75cbbfd21a640db10bca23319e52fa5a67fd43c5db43d3664a1f8300d2b634cae1b7b96996496a8fbf2b5688680bf0ee936ea9d2b072a556116fa653af

# ── Frontend ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
