{
  "name": "fafnir-tests",
  "version": "1.0.0",
  "description": "Fafnir Testing Codebase — Bridge, Financial Safety & Chaos Testing",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir unit",
    "test:bridge": "vitest run --dir bridge",
    "test:financial": "vitest run --dir financial",
    "test:security": "vitest run --dir security",
    "test:chaos": "vitest run --dir chaos",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=junit --outputFile=results.xml",
    "test:upgrade": "node self-upgrade/runner.js",
    "lint": "eslint . --ext .js,.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "nock": "^14.0.0",
    "sinon": "^19.0.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
